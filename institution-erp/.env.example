# ==============================================================================
# CampusCore (institution-erp) — Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL PRODUCTION SECRETS TO THIS FILE.
# Copy this file to .env and provide your deployment-specific credentials.
# ==============================================================================

# Database Configuration (PostgreSQL / Supabase)
POSTGRES_DB=institution_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<STRONG_DATABASE_PASSWORD>
POSTGRES_PORT=5432

# Backend API Configuration
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=institution_erp;Username=postgres;Password=<STRONG_DATABASE_PASSWORD>;

# Security & Authentication (JWT)
# Jwt__Secret MUST be at least 32 characters (256 bits). Use a cryptographically secure random string.
Jwt__Secret=<REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHIC_KEY>
Jwt__Issuer=InstitutionErp
Jwt__Audience=InstitutionErpApp
Jwt__ExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=7

# Initial Administrator Bootstrap Credentials
Admin__Email=admin@institution.edu
Admin__Password=<REPLACE_WITH_STRONG_BOOTSTRAP_PASSWORD_MIN_14_CHARS>

# CORS & Application URLs (No wildcard '*' or localhost in Production)
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
App__FrontendBaseUrl=http://localhost:3000

# Transactional Email (Brevo in Production / Smtp in Development)
Email__Provider=Smtp
Email__ApiKey=<YOUR_BREVO_API_KEY>
Email__FromAddress=notifications@institution.edu
Email__FromName=CampusCore ERP
Email__DailyLimit=300
Email__SmtpHost=localhost
Email__SmtpPort=1025

# Supabase Storage Configuration (Production)
Supabase__Url=https://<SUPABASE_PROJECT_REF>.supabase.co
Supabase__ServiceRoleKey=<SUPABASE_SERVICE_ROLE_KEY>
Supabase__StorageBucket=campuscore-documents

# Payment Gateway (Razorpay - Disabled and fail-closed by default)
Payment__Razorpay__Enabled=false
Payment__Razorpay__KeyId=<RAZORPAY_KEY_ID>
Payment__Razorpay__KeySecret=<RAZORPAY_KEY_SECRET>

# Frontend Environment Variables
VITE_API_URL=/api/v1
PORT=3000

# ──────────────────────────────────────────────────────────────────────────────
# Two-Factor Authentication (TOTP / RFC 6238)
# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED in Production. Generate a 32-byte AES-256-GCM encryption key:
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   Linux/Mac:  openssl rand -base64 32
# WARNING: Rotating this key requires re-encrypting all TOTP secrets in the DB.
Auth__Totp__EncryptionKey=<REPLACE_WITH_BASE64_32_BYTE_AES256_KEY>

# TOTP feature toggle and role enforcement (comma-separated)
Auth__Totp__Enabled=true
Auth__Totp__RequiredRoles=Principal,Teacher,Student

# Issuer name shown in Google/Microsoft Authenticator
Auth__Totp__Issuer=CampusCore

# Code window (number of 30s steps before/after current that are accepted, max 2)
Auth__Totp__Window=1

# Max failed TOTP attempts before challenge is locked
Auth__Totp__MaxAttempts=5

# Trusted-device cookie lifetime in days (0 = disable trusted devices)
Auth__Totp__TrustedDeviceDays=30

# Number of recovery codes generated at 2FA enrollment
Auth__Totp__RecoveryCodeCount=10
